{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "① 环境自检 (doctor)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--doctor"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      "name": "② 离线跑主循环 (不需要 key)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--mock",
        "--task",
        "离线验证 ReAct 主循环",
        "--url",
        "https://quotes.toscrape.com/"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      "name": "③ 真跑一个任务（可改参数）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--task",
        "打开名言网站首页，读出第一句名言的正文和作者",
        "--url",
        "https://quotes.toscrape.com/",
        "--headful"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      "name": "④ 浏览器层冒烟测试（不调模型）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/smoke_browser.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    },
    {
      "name": "⑤ 跑评测集",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/run_eval.py",
      "args": [],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    }
  ]
}
