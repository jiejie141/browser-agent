{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "① 环境自检 (doctor)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--doctor"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      // 实测站点表里每个搜索模板在**你当前网络下**能不能用。
      // 不调模型、不需要 key，纯浏览器探测；结果写入 runs/site_probe.json，
      // 控制台会读这份快照来显示每个站点的真实状态（而不是写死一个结论）。
      // 想缩小范围就把 --probe-only 打开，例：["--probe-sites","--probe-only","taobao,baidu"]
      "name": "①b 实测站点表可达性 (--probe-sites)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--probe-sites"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      "name": "② 离线跑主循环 (不需要 key)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--mock",
        "--task",
        "离线验证 ReAct 主循环",
        "--url",
        "https://quotes.toscrape.com/"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      "name": "③ 真跑一个任务（可改参数）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--task",
        "打开名言网站首页，读出第一句名言的正文和作者",
        "--url",
        "https://quotes.toscrape.com/",
        "--headful"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      "name": "④ 浏览器层冒烟测试（不调模型）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/smoke_browser.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    },
    {
      "name": "⑤ 跑评测集（基线 6 任务）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/run_eval.py",
      "args": [],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    },
    {
      // 基线只有 6 个任务、跑一次得不出可信数字：实测三轮分别是 3/6、2/6、3/6。
      // 这个配置就是用来量方差的 —— 跑完看 pass@3 与 pass^3 的差距，
      // 两者差得多说明是稳定性问题，不是能力问题。
      "name": "⑤b 基线 × 3 轮（量稳定性 pass@3 / pass^3）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/run_eval.py",
      "args": ["--repeat", "3"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    },
    {
      // 真实站点集。会自动先做环境预检，连不上的任务标 skipped 不计分 ——
      // 这样"模型不会做"和"这台机器连不上"不会混成同一个数字。
      "name": "⑤c 跑真实站点评测集（含环境预检）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/run_eval.py",
      "args": ["--task-file", "tasks/real_sites.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    },
    {
      // 最直观的一个：起来之后浏览器打开 http://127.0.0.1:8000/
      // 页面上勾「离线替身」→ 点快捷按钮 → 开始执行，就能看到逐步时间线。
      // 不勾离线替身才需要 .env 里的 LLM_API_KEY。
      "name": "⑥ 启动 Web 控制台（推荐先跑这个）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["bagent.api:app", "--host", "127.0.0.1", "--port", "8000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      // 起来后打开 http://127.0.0.1:8000/docs 可以直接在页面上试接口。
      "name": "⑥b 只启动 API（看 /docs）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["bagent.api:app", "--host", "127.0.0.1", "--port", "8001", "--reload"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      "name": "⑦ 跑全部单测",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8",
        // runner 上没有显示器；本地想看有头浏览器就把这行删掉
        "HEADLESS": "true"
      },
      "justMyCode": false
    },
    {
      "name": "⑧ 双引擎对比（手写 vs LangGraph）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/compare_engines.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    }
  ]
}
