{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "① 环境自检 (doctor)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--doctor"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      // 实测站点表里每个搜索模板在**你当前网络下**能不能用。
      // 不调模型、不需要 key，纯浏览器探测；结果写入 runs/site_probe.json，
      // 控制台会读这份快照来显示每个站点的真实状态（而不是写死一个结论）。
      // 想缩小范围就把 --probe-only 打开，例：["--probe-sites","--probe-only","taobao,baidu"]
      "name": "①b 实测站点表可达性 (--probe-sites)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--probe-sites"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      "name": "② 离线跑主循环 (不需要 key)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--mock",
        "--task",
        "离线验证 ReAct 主循环",
        "--url",
        "https://quotes.toscrape.com/"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      "name": "③ 真跑一个任务（可改参数）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--task",
        "打开名言网站首页，读出第一句名言的正文和作者",
        "--url",
        "https://quotes.toscrape.com/",
        "--headful"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      "name": "④ 浏览器层冒烟测试（不调模型）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/smoke_browser.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    },
    {
      "name": "⑤ 跑评测集（基线 6 任务）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/run_eval.py",
      "args": [],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    },
    {
      // 基线只有 6 个任务、跑一次得不出可信数字。
      // 这个配置就是用来量方差的 —— 跑完看 pass@3 与 pass^3 的差距，
      // 两者差得多说明是稳定性问题，不是能力问题。
      // 2026-09-21 修完 t02 截断、改正 t03 真值后实测：单轮 5/6、6/6、4/6，
      // 合计 15/18，pass@3 6/6 对 pass^3 3/6。
      "name": "⑤b 基线 × 3 轮（量稳定性 pass@3 / pass^3）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/run_eval.py",
      "args": ["--repeat", "3"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    },
    {
      // 真实站点集。会自动先做环境预检，连不上的任务标 skipped 不计分 ——
      // 这样"模型不会做"和"这台机器连不上"不会混成同一个数字。
      "name": "⑤c 跑真实站点评测集（含环境预检）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/run_eval.py",
      "args": ["--task-file", "tasks/real_sites.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    },
    {
      // 2026-09-21 修的那两条之一：t02 曾经 0/3，原因不是模型笨，
      // 是正文摘要按"头 750 + 中间省略 + 尾 750"拼，把"首句正文"和
      // "它自己的作者"切散了。改成保序截断后 3/3。
      // 跑完重点看两处：①「过/共」是不是 3/3；②表格里的「证据」列。
      "name": "⑤d 只跑 t02（看这次的修复）×3",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/run_eval.py",
      "args": ["--only", "t02", "--repeat", "3"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "justMyCode": false
    },
    {
      // 最直观的一个：起来之后浏览器打开 http://127.0.0.1:8000/
      // 页面上勾「离线替身」→ 点快捷按钮 → 开始执行，就能看到逐步时间线。
      // 不勾离线替身才需要 .env 里的 LLM_API_KEY。
      "name": "⑥ 启动 Web 控制台（推荐先跑这个）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["bagent.api:app", "--host", "127.0.0.1", "--port", "8000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      // 起来后打开 http://127.0.0.1:8000/docs 可以直接在页面上试接口。
      "name": "⑥b 只启动 API（看 /docs）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["bagent.api:app", "--host", "127.0.0.1", "--port", "8001", "--reload"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      "name": "⑦ 跑全部单测",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8",
        // runner 上没有显示器；本地想看有头浏览器就把这行删掉
        "HEADLESS": "true"
      },
      "justMyCode": false
    },
    {
      "name": "⑧ 双引擎对比（手写 vs LangGraph）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/compare_engines.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      // 跑一轮真实站点集要十几分钟，而"该不该配代理"是个配置问题。
      // 这个几秒就能回答：直连 vs 走代理的可达性对照。
      // 实测结论（2026-09-21）：12 个站直连 5/12、走代理也是 5/12 ——
      // 被拦的不是外网可达性，而是出口按 TLS 栈区分客户端，代理救不了。
      // 换代理地址就改下面 args 里的 --proxy。
      "name": "⑤e 站点可达性对照（直连 vs 代理）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/probe_reachability.py",
      "args": ["--proxy", "http://127.0.0.1:7890"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8",
        "HEADLESS": "true"
      },
      "justMyCode": false
    },
    {
      // ⭐ 模型层消融：同一套任务、同一份代码，只换模型。
      // 用途是把"骨架缺陷"和"模型缺陷"分开 —— 换强模型后仍然失败的，
      // 才是真的引擎问题（不是模型太笨）。基线（Qwen2.5-7B）是 15/18。
      // 注意 env 里的 LLM_MODEL **覆盖** .env 的值（load_dotenv 不覆盖已有环境变量），
      // 所以不会弄脏你的 .env。换别的强模型改这一行即可。
      "name": "⑨ 模型层消融（强模型 × 3 轮）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/run_eval.py",
      "args": ["--repeat", "3"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8",
        "HEADLESS": "true",
        "LLM_MODEL": "deepseek-ai/DeepSeek-V3.2"
      },
      "justMyCode": false
    },
    {
      // 验证实验 7 那条修复：scroll 指纹不再带 dy 之后，t06 会不会好一点。
      // 修复只把熔断点从"从不触发"提前到第 7 步（省 13 步），
      // **并不保证 t06 就过** —— 到底过不过，跑这个才知道。
      "name": "⑤f 只跑 t06（验证 scroll 指纹修复）×3",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/eval/run_eval.py",
      "args": ["--only", "t06", "--repeat", "3"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8",
        "HEADLESS": "true"
      },
      "justMyCode": false
    },
    {
      // 两条引擎的"什么时候停"必须一致，否则 A/B 对比失去意义。
      // 这里顺手把循环计数的口径也钉住：日志说"连续 N 次"，
      // 判据就不能是"累计 N 次"（真实轨迹里三条熔断有两条对不上）。
      "name": "⑦b 只跑熔断/循环检测相关单测",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_graph_agent.py::TestLoopCountsTellTheTruth",
        "tests/test_eval_preflight.py::TestTransportCrossCheck",
        "tests/test_browser.py::TestProxyLaunchKwargs",
        "-v"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONIOENCODING": "utf-8",
        // runner 上没有显示器；本地想看有头浏览器就把这行删掉
        "HEADLESS": "true"
      },
      "justMyCode": false
    }
  ]
}
