# 复制本文件为 .env 并填入你自己的 key
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=

MAX_STEPS=20
STEP_TIMEOUT_SECONDS=30
# 无头模式。代码里的默认值是 true（脚本/服务/容器都该无头；
# CI 的 runner 没有 X server，有头会直接崩）。
# 本地想看着浏览器一步步跑，就照这里填 false。
HEADLESS=false
LOG_LEVEL=INFO

# 浏览器收尾（关 context / 关浏览器 / 停 Playwright）的整体超时，秒。
# 收尾不属于任务本身：某些环境下 close() 会长时间不返回，超了就放弃等待，
# 免得"任务已完成"被一个无关步骤掩盖成"还在跑"。CI 上收尾约 1 秒，无需改动。
TEARDOWN_TIMEOUT_SECONDS=8

# Agent 引擎（新增）
#   handwritten：手写 ReAct 循环（默认，零额外依赖）
#   langgraph  ：LangGraph StateGraph 状态机（需 pip install langgraph）
ENGINE=handwritten

# 浏览器出口代理（可留空）。留空 = 不传 proxy 参数，跟随浏览器自身默认。
#
# 为什么要单独配这一份：系统代理是全局的，但浏览器该不该走代理取决于目标站点，
# 一刀切两边都会坏。真实约束（本机实测）：
#   - 国内站点经境外节点：淘宝只回 139 字空壳、百度直接 ERR_CONNECTION_CLOSED；
#   - GitHub / Google 不走代理又连不上；匿名搜索还会撞 429（共享出口 IP 被限流）。
# 所以想"两边都能跑"，就填上代理地址 + 把国内域名列进 bypass：
# BROWSER_PROXY=http://127.0.0.1:7890
# BROWSER_PROXY_BYPASS=baidu.com,taobao.com,weibo.com,douban.com,bilibili.com
#
# ⚠️ 但也别默认"开代理就能救回连不上的站" —— 2026-09-21 实测过一次：
#    12 个真实站点，直连 5/12，走 127.0.0.1:7890 还是 5/12，失败的是同一批
#    （豆瓣/微博/当当/B站/东方财富/12306）。排除过沙箱、IPv6、站点故障三种解释，
#    真正的原因是**出口在按 TLS 栈区分客户端**：只有 curl 的 schannel 能过，
#    chromium 的 BoringSSL 与 Python 的 OpenSSL 都过不去。
#    预检表现在会多一列「非浏览器通道」（跑 urllib + curl 两条栈），
#    专门把这类"站点是好的、只是这个客户端连不上"和"站点真挂了"分开。
BROWSER_PROXY=
BROWSER_PROXY_BYPASS=

# 服务化（新增，仅 `uvicorn bagent.api:app` 时需要）
API_HOST=127.0.0.1
API_PORT=8000
