# 复制本文件为 .env 并填入你自己的 key
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=

MAX_STEPS=20
STEP_TIMEOUT_SECONDS=30
HEADLESS=false
LOG_LEVEL=INFO

# Agent 引擎（新增）
#   handwritten：手写 ReAct 循环（默认，零额外依赖）
#   langgraph  ：LangGraph StateGraph 状态机（需 pip install langgraph）
ENGINE=handwritten

# 服务化（新增，仅 `uvicorn bagent.api:app` 时需要）
API_HOST=127.0.0.1
API_PORT=8000
