# 复制本文件为 .env 并填入你自己的 key
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=

MAX_STEPS=20
STEP_TIMEOUT_SECONDS=30
# 无头模式。代码里的默认值是 true（脚本/服务/容器都该无头；
# CI 的 runner 没有 X server，有头会直接崩）。
# 本地想看着浏览器一步步跑，就照这里填 false。
HEADLESS=false
LOG_LEVEL=INFO

# 浏览器收尾（关 context / 关浏览器 / 停 Playwright）的整体超时，秒。
# 收尾不属于任务本身：某些环境下 close() 会长时间不返回，超了就放弃等待，
# 免得"任务已完成"被一个无关步骤掩盖成"还在跑"。CI 上收尾约 1 秒，无需改动。
TEARDOWN_TIMEOUT_SECONDS=8

# Agent 引擎（新增）
#   handwritten：手写 ReAct 循环（默认，零额外依赖）
#   langgraph  ：LangGraph StateGraph 状态机（需 pip install langgraph）
ENGINE=handwritten

# 服务化（新增，仅 `uvicorn bagent.api:app` 时需要）
API_HOST=127.0.0.1
API_PORT=8000
